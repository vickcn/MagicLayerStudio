{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py?__studio_path=/$1" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tmp/**,samples/**,tests/**,**/*.test.py,**/__pycache__/**}"
    }
  }
}
