# ── Backend Mode ────────────────────────────────────────────────────────────
# local = Studio calls src.pipeline directly
STUDIO_BACKEND=local
# local = Studio receives multipart into /tmp; gcs = browser direct upload via Core signed URL
STUDIO_UPLOAD_MODE=local

# ── MagicLayerCore Remote API (Vercel / Cloud Run) ───────────────────────────
# STUDIO_BACKEND=core_api
# STUDIO_UPLOAD_MODE=gcs
# MAGICLAYER_CORE_URL=https://magiclayer-core-xxxxxxxx.asia-east1.run.app
# MAGICLAYER_CORE_TOKEN=your_secure_core_bearer_token

# ── Google OAuth 2.0 ────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=https://your-magiclayer-studio.vercel.app/auth/google/callback

# ── Neon / Serverless PostgreSQL ────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@ep-xxxx.asia-southeast1.aws.neon.tech/magiclayer?sslmode=require

# ── Optional Local/Server Settings ──────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=86400
