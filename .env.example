# local development: Studio calls src.pipeline directly
STUDIO_BACKEND=local
# local = Studio receives multipart into /tmp; gcs = browser direct upload via Core signed URL
STUDIO_UPLOAD_MODE=local

# Vercel/remote deployment: Studio calls MagicLayerCore
# STUDIO_BACKEND=core_api
# STUDIO_UPLOAD_MODE=gcs
# MAGICLAYER_CORE_URL=https://your-core-api.example.com
# MAGICLAYER_CORE_TOKEN=

# Optional local/server settings
MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=86400
